# Copy to .env and change the passwords: cp .env.example .env
# The same file is read by Docker Compose (npm run infra:*) and by the Node services.

# ---------- Docker Compose ----------
COMPOSE_PROJECT_NAME=ticketsurge

POSTGRES_USER=ticketsurge
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ticketsurge
# Host ports. Defaults avoid clashing with other local PostgreSQL/Redis instances on 5432/6379.
POSTGRES_HOST_PORT=5433

REDIS_PASSWORD=change-me-redis
REDIS_HOST_PORT=6380

KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8080

# Monitoring. Grafana runs on 3002 because the API uses 3000.
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3002
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- Node services ----------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000

# Must match the POSTGRES_* and REDIS_* values above.
DATABASE_URL=postgres://ticketsurge:change-me-postgres@localhost:5433/ticketsurge
REDIS_URL=redis://:change-me-redis@localhost:6380/0

# Comma-separated list of host:port
KAFKA_BROKERS=localhost:9092
# Prepended to every topic and consumer group. Leave empty; tests set their own.
KAFKA_TOPIC_PREFIX=
# Topic settings used by `npm run kafka:topics`. Production-style: replication factor 3
# (min.insync.replicas is then set to 2, so acks=all survives losing one broker).
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_MS=604800000

# ---------- Metrics ----------
# Each worker serves GET /metrics on its own port (the API and gateway use their HTTP ports).
# Defaults: admission 9101, booking-worker 9102, payment 9103, ticket 9104, notification 9105,
# analytics 9106. Set METRICS_PORT per process to override; 0 disables it.

# ---------- Outbox relay (booking-worker and every publishing service) ----------
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=200
# Partitions each consumer processes in parallel (order is kept within a partition).
CONSUMER_CONCURRENCY=6

# ---------- booking-worker ----------
# Parts to run in this process: relay, saga, sweeper, seat-sync (comma-separated; default all).
BOOKING_WORKER_ROLES=relay,saga,sweeper,seat-sync
# Expiry sweeper: how often it runs, how many bookings per round, and the outbox backlog above
# which it pauses (a lagging relay means payments may not have had a chance to arrive).
SWEEP_INTERVAL_MS=1000
SWEEP_BATCH_SIZE=100
SWEEPER_MAX_OUTBOX_BACKLOG=1000

# ---------- realtime-gateway (WebSocket at ws://localhost:3001/ws?token=<access token>) ----------
REALTIME_HOST=0.0.0.0
REALTIME_PORT=3001
WS_MAX_SUBSCRIPTIONS=20
WS_PING_INTERVAL_MS=30000

# ---------- payment-service (simulated provider) ----------
PAYMENT_DELAY_MS=1000
# Share of charges that fail, 0 to 1.
PAYMENT_FAILURE_RATE=0.1

# Each dependency check in GET /health fails if it takes longer than this.
HEALTH_CHECK_TIMEOUT_MS=2000

# HS256 key for access tokens. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_TTL_SECONDS=3600

# Comma-separated emails of users allowed to call /admin/* routes.
ADMIN_EMAILS=admin@ticketsurge.local

# Comma-separated browser origins allowed to call the API directly (CORS). The demo site at
# https://ticketsurge-web.vercel.app is allowed, so its "Connect my backend" button works with this
# file as it is. Add another address if you host your own copy. The site run locally with
# npm run dev needs nothing here: its proxy needs no CORS.
CORS_ORIGINS=https://ticketsurge-web.vercel.app

# ---------- Seat holds ----------
# Redis commands slower than this fail and the request gets 503.
REDIS_COMMAND_TIMEOUT_MS=1000
HOLD_TTL_MS=600000
MAX_SEATS_PER_HOLD=8

# ---------- Rate limits (per user, per window) ----------
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_QUEUE_JOIN=5
RATE_LIMIT_HOLDS=10
RATE_LIMIT_BOOKINGS=10

# ---------- Admission worker ----------
# Admits up to ADMISSION_BATCH_SIZE waiting users per event every ADMISSION_INTERVAL_MS.
ADMISSION_INTERVAL_MS=1000
ADMISSION_BATCH_SIZE=50
# How long an admitted user may hold seats before having to queue again.
ADMISSION_TTL_MS=300000

# ---------- Bookings ----------
# Payment deadline after booking creation; the hold is reset to expire HOLD_AFTER_DEADLINE_MS later.
PAYMENT_DEADLINE_MS=300000
HOLD_AFTER_DEADLINE_MS=60000