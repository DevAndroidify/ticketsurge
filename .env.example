# Copy to .env and change the passwords: cp .env.example .env
# The same file is read by Docker Compose (npm run infra:*) and by the Node services.

# ---------- Docker Compose ----------
COMPOSE_PROJECT_NAME=ticketsurge

POSTGRES_USER=ticketsurge
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ticketsurge
# Host ports. Defaults avoid clashing with other local PostgreSQL/Redis instances on 5432/6379.
POSTGRES_HOST_PORT=5433

REDIS_PASSWORD=change-me-redis
REDIS_HOST_PORT=6380

KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8080

# ---------- Node services ----------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000

# Must match the POSTGRES_* and REDIS_* values above.
DATABASE_URL=postgres://ticketsurge:change-me-postgres@localhost:5433/ticketsurge
REDIS_URL=redis://:change-me-redis@localhost:6380/0

# Comma-separated list of host:port
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ticketsurge-api

# Each dependency check in GET /health fails if it takes longer than this.
HEALTH_CHECK_TIMEOUT_MS=2000

# HS256 key for access tokens. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_TTL_SECONDS=3600

# Comma-separated emails of users allowed to call /admin/* routes.
ADMIN_EMAILS=admin@ticketsurge.local

# ---------- Seat holds ----------
# Redis commands slower than this fail and the request gets 503.
REDIS_COMMAND_TIMEOUT_MS=1000
HOLD_TTL_MS=600000
MAX_SEATS_PER_HOLD=8

# ---------- Bookings ----------
# Payment deadline after booking creation; the hold is reset to expire HOLD_AFTER_DEADLINE_MS later.
PAYMENT_DEADLINE_MS=300000
HOLD_AFTER_DEADLINE_MS=60000
# TEMPORARY: skip the queue admission check. Removed when the virtual queue exists.
ADMISSION_BYPASS=true
