{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    // Builds resolve workspace packages to their compiled dist, not their sources.
    "customConditions": []
